# このファイルをコピーして .env を作る:  cp .env.example .env
# .env は .gitignore 済み。実際の値をこのファイルに書かないこと。

# --- LLM (OpenAI 互換) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# --- 差し替え検証用の 2 つ目の provider（provider 抽象の動作確認用）---
LLM_ALT_BASE_URL=
LLM_ALT_API_KEY=
LLM_ALT_MODEL=

# --- Embedding（Chat 系 API とは別 provider。DeepSeek は embeddings 未提供）---
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Database ---
DATABASE_URL=postgresql://konkyo:konkyo@localhost:5432/konkyo

# --- App ---
APP_ENV=development
LOG_LEVEL=info

# --- コスト上限 ---
MAX_AGENT_STEPS=10
MAX_TOKENS_PER_REQUEST=100000
