# このファイルをコピーして .env を作る:  cp .env.example .env
# .env は .gitignore 済み。実際の値をこのファイルに書かないこと。
#
# 実際にコードが読んでいる変数だけを置く。まだ実装していない機能（embedding、DB など）の
# 変数は、その機能を作るときに追加する。

# --- LLM (OpenAI 互換) ---
# 実測済みなのは火山方舟（Ark）経由の deepseek-v4-1-flash だけ。
# 別の provider に替える場合は、llm.py の extra_body（thinking 無効化）と
# usage の解析を、実際のレスポンスで確認し直すこと。
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=deepseek-v4-1-flash-260910

# --- server.py の CORS（カンマ区切りで複数可）---
# 本番ドメインにデプロイしたら、ここをそのドメインに変更する
CORS_ALLOW_ORIGINS=http://localhost:3000
